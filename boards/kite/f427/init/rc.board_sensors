#!/bin/sh
#
# Kite F427 specific board sensors init
#------------------------------------------------------------------------------

board_adc start

# Internal SPI bus - SPL06-001 Barometer
spl06 -s start

# Internal I2C bus - QMC5883L Magnetometer (I2C interface)
qmc5883l -I start

# Internal SPI bus - BMI088 IMU (Accel and Gyro)
bmi088 -A -s start
bmi088 -G -s start
