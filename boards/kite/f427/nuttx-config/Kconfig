config BOARD_HAS_PROBES
	bool "Board provides GPIO or other Hardware for signaling to timing analyze."
	default y
	---help---
		This board provides GPIO PWM_OUT1-6 (PE14, PE13, PE11, PE9, PD13, PD14) to provide timing signals from selected drivers.

config BOARD_USE_PROBES
	bool "Enable the use the board provided PWM_OUT1-6 as PROBE_1-6"
	default n
	depends on BOARD_HAS_PROBES

	---help---
		Select to use GPIO PWM_OUT1-6 (PE9, PE11, PE13, PE14, PD13, PD14) to provide timing signals from selected drivers.
